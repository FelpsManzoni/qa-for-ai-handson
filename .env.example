# Copy this file to .env and fill in your own OpenRouter key.
# Only needed for `--mode online`. Offline mode needs none of this.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Which model to call. Check https://openrouter.ai/models for current
# free-tier (":free" suffix) options and their rate limits before the
# event — availability changes over time and is NOT guaranteed by this repo.
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
